# OpenZeppelin Relayer environment variables.
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# UUID v4 used as the bearer token for the relayer's REST API.
# Generate with: uuidgen  (or `cat /proc/sys/kernel/random/uuid`)
API_KEY=

# UUID v4 used to sign outgoing webhook notifications.
# Generate with: uuidgen
WEBHOOK_SIGNING_KEY=

# Passphrase that encrypts the local v3 keystore at config/keys/local-signer.json.
# Must be 12+ chars and include: uppercase, lowercase, number, special character.
KEYSTORE_PASSPHRASE=

# Hex-encoded private key used by `scripts/setup.sh` to materialize the keystore.
# Only read by the setup script — the relayer container never sees it.
# Use a freshly generated key and fund it with testnet PAS.
RELAYER_PRIVATE_KEY=
